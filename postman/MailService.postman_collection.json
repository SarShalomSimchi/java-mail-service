        "header": [],
        "url": "{{baseUrl}}/search?subject=AutomatedBulkSubject2-{{runId}}",
        "description": "Checks that omitted sender and recipient filters are ignored."
      },
      "response": []
    },
    {
      "name": "08 - Get All Sent Emails",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Sent list contains emails created in this run', function () {",
              "    pm.expect(json).to.be.an('array');",
              "    const ids = json.map(e => String(e.id));",
              "    [",
              "        'noAttachmentEmailId',",
              "        'singleEmailId',",
              "        'multiEmailId',",
              "        'bulkEmail1Id',",
              "        'bulkEmail2Id'",
              "    ].forEach(function (name) {",
              "        pm.expect(ids).to.include(pm.collectionVariables.get(name));",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/sent",
        "description": "Checks that the persisted emails from the current automated run are present in the sent list."
      },
      "response": []
    },
    {
      "name": "09 - Download Attachment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Download headers are correct', function () {",
              "    const disposition = pm.response.headers.get('Content-Disposition');",
              "    const contentType = pm.response.headers.get('Content-Type');",
              "    const contentLength = Number(pm.response.headers.get('Content-Length'));",
              "    pm.expect(disposition).to.include('attachment-a.txt');",
              "    pm.expect(contentType).to.include('text/plain');",
              "    pm.expect(contentLength).to.be.above(0);",
              "});",
              "pm.test('Downloaded content matches the fixture', function () {",
              "    pm.expect(pm.response.text()).to.eql('Mail Service automated attachment A.\\n');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/attachments/{{singleAttachmentId}}/download",
        "description": "Downloads the attachment created in request 02 and validates its headers and exact text content."
      },
      "response": []
    },
    {
      "name": "10 - Get Missing Email - 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Error response describes the missing email', function () {",
              "    pm.expect(json.status).to.eql(404);",
              "    pm.expect(json.error).to.eql('Not Found');",
              "    pm.expect(json.message).to.include('Email not found with ID');",
              "    pm.expect(json.path).to.include('/api/emails/999999999');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/999999999",
        "description": "Verifies the ResourceNotFoundException path for an email ID that should not exist."
      },
      "response": []
