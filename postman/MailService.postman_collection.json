  "item": [
    {
      "name": "01 - Send Email - No Attachment",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString() + '-' + Math.floor(Math.random() * 100000).toString();",
              "pm.collectionVariables.set('runId', runId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "const runId = pm.collectionVariables.get('runId');",
              "pm.test('Response contains the created email', function () {",
              "    pm.expect(json).to.have.property('id');",
              "    pm.expect(json).to.have.property('sender');",
              "    pm.expect(json).to.have.property('recipient');",
              "    pm.expect(json).to.have.property('subject');",
              "    pm.expect(json).to.have.property('body');",
              "    pm.expect(json).to.have.property('createDate');",
              "    pm.expect(json).to.have.property('attachments');",
              "    pm.expect(json.attachments).to.be.an('array');",
              "    pm.expect(json.sender).to.eql(`noattachment.${runId}@example.com`);",
              "    pm.expect(json.recipient).to.eql(`recipient0.${runId}@example.com`);",
              "    pm.expect(json.subject).to.eql(`AutomatedNoAttachment-${runId}`);",
              "    pm.expect(json.attachments).to.have.lengthOf(0);",
              "});",
              "pm.collectionVariables.set('noAttachmentEmailId', String(json.id));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "sender",
              "value": "noattachment.{{runId}}@example.com",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "recipient",
              "value": "recipient0.{{runId}}@example.com",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "subject",
              "value": "AutomatedNoAttachment-{{runId}}",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "body",
              "value": "Automated no-attachment body {{runId}}",
              "type": "text",
              "contentType": "text/plain"
            }
          ]
        },
        "url": "{{baseUrl}}/send",
        "description": "Creates a single email without attachments. This request also creates a fresh runId for the entire collection run."
      },
      "response": []
    },
    {
      "name": "02 - Send Email - One Attachment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "const runId = pm.collectionVariables.get('runId');",
              "pm.test('One attachment is persisted and returned', function () {",
              "    pm.expect(json).to.have.property('id');",
              "    pm.expect(json).to.have.property('sender');",
              "    pm.expect(json).to.have.property('recipient');",
              "    pm.expect(json).to.have.property('subject');",
              "    pm.expect(json).to.have.property('body');",
              "    pm.expect(json).to.have.property('createDate');",
              "    pm.expect(json).to.have.property('attachments');",
              "    pm.expect(json.attachments).to.be.an('array');",
              "    pm.expect(json.sender).to.eql(`single1.${runId}@example.com`);",
              "    pm.expect(json.recipient).to.eql(`recipient1.${runId}@example.com`);",
              "    pm.expect(json.subject).to.eql(`AutomatedSingleSubject-${runId}`);",
              "    pm.expect(json.attachments).to.have.lengthOf(1);",
              "    pm.expect(json.attachments[0].fileName).to.eql('attachment-a.txt');",
              "    pm.expect(json.attachments[0].mimeType).to.include('text/plain');",
              "    pm.expect(json.attachments[0].fileSize).to.be.above(0);",
              "    pm.expect(json.attachments[0].downloadUrl).to.eql(`/api/emails/attachments/${json.attachments[0].id}/download`);",
              "});",
              "pm.collectionVariables.set('singleEmailId', String(json.id));",
              "pm.collectionVariables.set('singleAttachmentId', String(json.attachments[0].id));",
              "pm.collectionVariables.set('singleAttachmentFileName', json.attachments[0].fileName);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "sender",
              "value": "single1.{{runId}}@example.com",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "recipient",
              "value": "recipient1.{{runId}}@example.com",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "subject",
              "value": "AutomatedSingleSubject-{{runId}}",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "body",
              "value": "Automated single attachment body {{runId}}",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "attachments",
              "type": "file",
              "src": "test-files/attachment-a.txt",
              "contentType": "text/plain"
            }
          ]
        },
        "url": "{{baseUrl}}/send",
        "description": "Creates one email with one local text attachment and stores the generated email and attachment IDs for later requests."
      },
      "response": []
    },
    {
      "name": "03 - Send Email - Multiple Attachments",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "const runId = pm.collectionVariables.get('runId');",
              "pm.test('Two attachments are persisted and returned', function () {",
              "    pm.expect(json.sender).to.eql(`single2.${runId}@example.com`);",
              "    pm.expect(json.attachments).to.be.an('array').with.lengthOf(2);",
              "    const names = json.attachments.map(a => a.fileName);",
              "    pm.expect(names).to.include('attachment-a.txt');",
              "    pm.expect(names).to.include('attachment-b.txt');",
              "    json.attachments.forEach(function (a) {",
              "        pm.expect(a.id).to.exist;",
              "        pm.expect(a.fileSize).to.be.above(0);",
              "    });",
              "});",
              "pm.collectionVariables.set('multiEmailId', String(json.id));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "sender",
              "value": "single2.{{runId}}@example.com",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "recipient",
              "value": "recipient2.{{runId}}@example.com",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "subject",
              "value": "AutomatedMultiSubject-{{runId}}",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "body",
              "value": "Automated multiple attachment body {{runId}}",
              "type": "text",
              "contentType": "text/plain"
            },
            {
              "key": "attachments",
              "type": "file",
              "src": "test-files/attachment-a.txt",
              "contentType": "text/plain"
            },
            {
              "key": "attachments",
              "type": "file",
              "src": "test-files/attachment-b.txt",
              "contentType": "text/plain"
            }
          ]
        },
        "url": "{{baseUrl}}/send",
        "description": "Creates one email with two attachments using the same multipart key, matching List<MultipartFile> attachments."
      },
      "response": []
    },
    {
      "name": "04 - Send Bulk Emails - Shared Attachments",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "const runId = pm.collectionVariables.get('runId');",
              "pm.test('Bulk response contains two emails', function () {",
              "    pm.expect(json).to.be.an('array').with.lengthOf(2);",
              "    pm.expect(json[0].sender).to.eql(`bulk1.${runId}@example.com`);",
              "    pm.expect(json[1].sender).to.eql(`bulk2.${runId}@example.com`);",
              "});",
              "pm.test('Bulk attachment mapping is correct', function () {",
              "    pm.expect(json[0].attachments).to.have.lengthOf(1);",
              "    pm.expect(json[0].attachments[0].fileName).to.eql('attachment-b.txt');",
              "    pm.expect(json[1].attachments).to.have.lengthOf(2);",
              "    const names = json[1].attachments.map(a => a.fileName);",
              "    pm.expect(names).to.include('attachment-a.txt');",
              "    pm.expect(names).to.include('attachment-b.txt');",
              "});",
              "pm.collectionVariables.set('bulkEmail1Id', String(json[0].id));",
              "pm.collectionVariables.set('bulkEmail2Id', String(json[1].id));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "eba625c6-ae6e-4ecb-8e2a-17fa93f28ffc",
              "type": "file",
              "src": "test-files/attachment-a.txt",
              "contentType": "text/plain"
            },
            {
              "key": "ddbeceac-78a9-4ada-a047-8be226406124",
              "type": "file",
              "src": "test-files/attachment-b.txt",
              "contentType": "text/plain"
            },
            {
              "key": "emailRequests",
              "value": "[\n  {\n    \"sender\": \"bulk1.{{runId}}@example.com\",\n    \"recipient\": \"bulkrecipient1.{{runId}}@example.com\",\n    \"subject\": \"AutomatedBulkSubject1-{{runId}}\",\n    \"body\": \"Automated bulk body 1 {{runId}}\",\n    \"attachmentIds\": [\"ddbeceac-78a9-4ada-a047-8be226406124\"]\n  },\n  {\n    \"sender\": \"bulk2.{{runId}}@example.com\",\n    \"recipient\": \"bulkrecipient2.{{runId}}@example.com\",\n    \"subject\": \"AutomatedBulkSubject2-{{runId}}\",\n    \"body\": \"Automated bulk body 2 {{runId}}\",\n    \"attachmentIds\": [\"eba625c6-ae6e-4ecb-8e2a-17fa93f28ffc\", \"ddbeceac-78a9-4ada-a047-8be226406124\"]\n  }\n]",
              "type": "text",
              "contentType": "application/json"
            }
          ]
        },
        "url": "{{baseUrl}}/bulk",
        "description": "Matches the working manual bulk scenario: email 1 uses one attachment; email 2 uses both attachments. Multipart file part names are UUIDs referenced by attachmentIds."
      },
      "response": []
    },
    {
      "name": "05 - Get Email By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "const runId = pm.collectionVariables.get('runId');",
              "pm.test('Returned email matches the previously created email', function () {",
              "    pm.expect(String(json.id)).to.eql(pm.collectionVariables.get('singleEmailId'));",
              "    pm.expect(json.sender).to.eql(`single1.${runId}@example.com`);",
              "    pm.expect(json.recipient).to.eql(`recipient1.${runId}@example.com`);",
              "    pm.expect(json.attachments).to.have.lengthOf(1);",
              "    pm.expect(String(json.attachments[0].id)).to.eql(pm.collectionVariables.get('singleAttachmentId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/{{singleEmailId}}",
        "description": "Reads the email created in request 02 using the dynamically stored ID."
      },
      "response": []
    },
    {
      "name": "06 - Search Emails - Sender Recipient Subject",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "const expectedId = pm.collectionVariables.get('singleEmailId');",
              "pm.test('Search result contains the email created in request 02', function () {",
              "    pm.expect(json).to.be.an('array');",
              "    const ids = json.map(e => String(e.id));",
              "    pm.expect(ids).to.include(expectedId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/search?sender=single1.{{runId}}@example.com&recipient=recipient1.{{runId}}@example.com&subject=AutomatedSingleSubject-{{runId}}",
        "description": "Checks all three optional search filters together."
      },
      "response": []
    },
    {
      "name": "07 - Search Emails - Subject Only",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
